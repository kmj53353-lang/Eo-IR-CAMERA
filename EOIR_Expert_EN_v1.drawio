                    <mxGeometry x="2183" y="687" width="100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="84" value="R_f = V_FS/I_max = 5V/50μA = 100kΩ&#xa;f_-3dB = 1/(2π×R_f×C_f) = 1.6MHz&#xa;C_f = 1.6pF (위상마진 확보)&#xa;Noise = √(4kT×R_f×BW) [V/√Hz]" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
