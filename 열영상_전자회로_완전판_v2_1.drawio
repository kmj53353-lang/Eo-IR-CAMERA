    <mxCell id="s4_why_lbl" value="WHY" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#58a6ff;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="68" y="1461" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s4_why_t" value="InSb 검출기: 77K 정밀 유지 필수&#xa;온도 편차 1K → 암전류 2배 증가&#xa;TEC(펠티어): 전류방향으로 냉각/가열&#xa;목표: ±0.01K 정밀 온도 제어" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="68" y="1481" width="300" height="76" as="geometry"/>
    </mxCell>

    <mxCell id="s4_what_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#7ee787;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="390" y="1453" width="320" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s4_what_lbl" value="WHAT" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#7ee787;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="403" y="1461" width="100" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s4_what_t" value="NTC: R_T = R_25 × exp(B(1/T − 1/T_25))&#xa;PID: u = Kp×e + Ki×∫e dt + Kd×de/dt&#xa;H-Bridge: 양방향 전류로 냉각/가열&#xa;Q_cold = α×I×Tc − ½I²R − K×ΔT" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="403" y="1481" width="300" height="76" as="geometry"/>
    </mxCell>

    <mxCell id="s4_how_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#ffa657;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="725" y="1453" width="420" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s4_how_lbl" value="HOW" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="738" y="1461" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s4_how_t" value="① NTC → Wheatstone 브리지 → InAmp(AD8221)&#xa;② 온도 ADC → MCU(STM32) PID 연산 500Hz&#xa;③ DRV8701 게이트드라이버 → 4×MOSFET H-Bridge&#xa;④ PWM 20kHz (가청주파수 이상) → TEC 전류 제어" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="738" y="1481" width="400" height="76" as="geometry"/>
    </mxCell>

