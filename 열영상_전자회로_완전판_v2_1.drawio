    <mxCell id="s3_why_lbl" value="WHY" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#58a6ff;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="68" y="1026" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s3_why_t" value="픽셀 제조편차 → FPN(고정패턴잡음) 발생&#xa;kTC 잡음 = √(kT/C): 리셋 시 발생&#xa;CDS: V_signal − V_reset 차분으로 제거&#xa;CTIA: 전류를 C_int에 적분 → 전압 출력" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="68" y="1046" width="300" height="76" as="geometry"/>
    </mxCell>

    <mxCell id="s3_what_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#7ee787;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="390" y="1018" width="320" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s3_what_lbl" value="WHAT" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#7ee787;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="403" y="1026" width="100" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s3_what_t" value="V_out = I_photo × t_int / C_int&#xa;C_int: 적분 커패시터 (50fF ~ 200fF)&#xa;순서: Reset → 적분 → S/H → CDS → ADC&#xa;DR = V_swing × C_int / I_max" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="403" y="1046" width="300" height="76" as="geometry"/>
    </mxCell>

    <mxCell id="s3_how_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#ffa657;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="725" y="1018" width="420" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s3_how_lbl" value="HOW" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
