    <mxCell id="s3_title" value="③ CTIA ROIC + CDS (상관이중샘플링) — FPN/kTC 잡음 제거" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
