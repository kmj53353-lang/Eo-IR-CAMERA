    <mxCell id="formulas_title" value="📐 핵심 수식 모음" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;fontColor=#00e5a0;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2392" width="400" height="28" as="geometry"/>
    </mxCell>

    <mxCell id="f_tia_lbl" value="TIA" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2430" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_tia" value="V_out = −I_pd × R_f  │  f_-3dB = 1/(2π×R_f×C_f)  │  Noise = √(4kT×R_f×BW)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2430" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_ctia_lbl" value="CTIA" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2456" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_ctia" value="V_out = I×t_int/C_int  │  DR = V_swing×C_int/I_max  │  kTC = √(kT/C) → CDS로 제거" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2456" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_adc_lbl" value="ADC" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2482" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_adc" value="V_LSB = V_ref/2^N = 5V/16384 = 305μV  │  SNR = 6.02×N+1.76 = 86.1dB (N=14)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2482" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_tec_lbl" value="TEC" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2508" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_tec" value="Q_cold = α×I×Tc − ½I²R − K×ΔT  │  I_opt = αΔT/R  │  PID: Kp×e+Ki∫e+Kd×ė" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2508" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_lvds_lbl" value="LVDS" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2534" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_lvds" value="Z_diff ≈ 100Ω  │  V_OD=350mV  │  l &lt; λ/10 (집중정수 조건)  │  스큐 ≤ ±5ps" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2534" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_pcb_lbl" value="PCB Z0" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2560" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_pcb" value="Z0 = 87/√(ε_r+1.41) × ln(5.98h/(0.8w+t))  │  차동: Z_diff ≈ 2Z0(1−0.347e^(−2.9s/2h))" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2560" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_mos_lbl" value="MOSFET" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2586" width="90" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_mos" value="P_sw = ½×V_DS×I_D×(t_r+t_f)×f  │  P_cond = I²×R_DS(on)  │  T_j = T_amb+P×θ_JA" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="160" y="2586" width="900" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="f_nuc_lbl" value="NUC" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="60" y="2612" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="f_nuc" value="V_corr = G×V_raw + O  │  G=(V2−V1)/(T2−T1)  │  NEDT = V_noise/(dV/dT) [mK]" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
