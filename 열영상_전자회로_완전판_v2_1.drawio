    <!-- WHY/WHAT/HOW -->
    <mxCell id="s2_why_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#388bfd;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="55" y="583" width="320" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s2_why_lbl" value="WHY" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#58a6ff;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="68" y="591" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s2_why_t" value="ROIC 출력 = 전류 수 pA 수준&#xa;ADC는 전압 입력 → 전류→전압 변환 필수&#xa;V_out = −I_pd × R_f (반전증폭)&#xa;가상단락: V(−) = V(+) = 0V" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="68" y="611" width="300" height="76" as="geometry"/>
    </mxCell>

    <mxCell id="s2_what_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#7ee787;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="390" y="583" width="320" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s2_what_lbl" value="WHAT" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#7ee787;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="403" y="591" width="100" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s2_what_t" value="R_f = V_FS/I_max = 5V/50μA = 100kΩ&#xa;f_-3dB = 1/(2π×R_f×C_f) = 1.6MHz&#xa;C_f = 1.6pF (위상마진 확보)&#xa;Noise = √(4kT×R_f×BW) [V/√Hz]" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="403" y="611" width="300" height="76" as="geometry"/>
    </mxCell>

    <mxCell id="s2_how_bg" value="" style="rounded=1;fillColor=#161b22;strokeColor=#ffa657;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="725" y="583" width="420" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s2_how_lbl" value="HOW" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#ffa657;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="738" y="591" width="80" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="s2_how_t" value="① OPA657: GBW=1.6GHz, e_n=4.8nV/√Hz, FET입력&#xa;② GBW 조건: 1.6GHz ≥ Gain×f_sig×10 확인&#xa;③ 전원: ±5V 양전원, VCC핀 100nF 디커플링&#xa;④ 레이아웃: R_f/C_f를 OpAmp 핀에 최대한 근접" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#c9d1d9;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="738" y="611" width="400" height="76" as="geometry"/>
    </mxCell>

