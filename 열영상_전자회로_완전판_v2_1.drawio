    <mxCell id="s2_title" value="② TIA — Trans-Impedance Amplifier (OPA657, GBW=1.6GHz)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#d2a8ff;fontFamily=Courier New;" vertex="1" parent="1">
